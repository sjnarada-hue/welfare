# Claude API 키 (없으면 버튼 답변 + 사람 연결만 동작합니다)
ANTHROPIC_API_KEY=
# 사용할 모델과 답변 깊이(low/medium/high). 기본값: claude-opus-5-5 / low
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# 오픈빌더 스킬 '헤더 값'(X-Skill-Token)과 같게 설정하면 외부 요청을 막습니다. 비워 두면 검사 안 함.
KAKAO_SKILL_TOKEN=
# 콜백을 쓰지 않는 블록에서 AI 답을 기다릴 최대 초(카카오 제한 5초)
SYNC_AI_TIMEOUT=4.0
